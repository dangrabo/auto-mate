# auto-mate configuration — copy to .env and fill in real values.
# .env is gitignored; this file (no real secrets) is committed as documentation.

# --- GitHub ---------------------------------------------------------------

# Personal Access Token used to read issues and open PRs.
# Minimum scope: "repo" (classic) or Contents + Pull requests + Issues (fine-grained).
GITHUB_PAT=

# The single repo auto-mate watches and opens PRs against, as "owner/name".
GITHUB_REPO=your-org/your-repo

# The issue label that opts a ticket in to automation.
AUTOMATION_LABEL=automate

# --- Anthropic ----------------------------------------------------------------

# API key for the triage call and for `claude -p`.
ANTHROPIC_API_KEY=

# Model for the cheap "does this need code?" triage call.
TRIAGE_MODEL=claude-haiku-4-5

# --- Local paths ------------------------------------------------------------

# Where per-repo clones and per-job worktrees live.
WORKSPACES_DIR=workspaces

# SQLite database file.
DATABASE_URL=sqlite:///automate.db

# --- Poller -----------------------------------------------------------------

# Seconds between GitHub polls.
POLL_INTERVAL_SECONDS=300
